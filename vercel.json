{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],

  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],

  "crons": [
    {
      "path": "/scraper/run",
      "schedule": "0 15 * * *"
    }
  ]
}